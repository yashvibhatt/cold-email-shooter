# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# When SAFE_MODE=true emails are NOT sent – they are only logged.
# Set to false to send real emails through Outlook.
SAFE_MODE=true

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ces_user:ces_pass@localhost:5432/cold_email_shooter

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Session ─────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_very_long_random_string_at_least_32_chars

# ─── Microsoft / Azure ───────────────────────────────────────────────────────
# Register your app at https://portal.azure.com → Azure Active Directory
# → App registrations → New registration
#
# Required API permissions (delegated):
#   - openid, profile, email, offline_access
#   - Mail.Send
#   - User.Read
#
# Add a redirect URI:  http://localhost:3001/api/auth/callback  (Web platform)

MICROSOFT_CLIENT_ID=your_azure_client_id_here
MICROSOFT_CLIENT_SECRET=your_azure_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
